// Shared build settings for both Spatial Bridge app targets.
// Signing: automatic, personal team (ADR-009). Override DEVELOPMENT_TEAM locally with
// `xcodebuild DEVELOPMENT_TEAM=XXXX` or a Local.xcconfig (git-ignored) if you use a different team.
#include? "Local.xcconfig"

DEVELOPMENT_TEAM = $(SB_DEVELOPMENT_TEAM:default=TWR2VXDJQB)
CODE_SIGN_STYLE = Automatic
SB_BUNDLE_PREFIX = $(SB_BUNDLE_PREFIX_OVERRIDE:default=com.gowthammohan.spatialbridge)

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES
SWIFT_UPCOMING_FEATURE_EXISTENTIAL_ANY = YES
SWIFT_TREAT_WARNINGS_AS_ERRORS = NO
SWIFT_EMIT_LOC_STRINGS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
STRING_CATALOG_GENERATE_SYMBOLS = YES

GENERATE_INFOPLIST_FILE = YES
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES
ENABLE_PREVIEWS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
ENABLE_TESTABILITY[config=Debug] = YES
PRODUCT_NAME = $(TARGET_NAME)

// Privacy strings shared by both apps.
INFOPLIST_KEY_NSLocalNetworkUsageDescription = Spatial Bridge uses your local network to find and connect to your paired devices. Files are sent directly between them and never leave your network.
INFOPLIST_KEY_NSHumanReadableCopyright = © 2026 Gowtham Mohan

// Security-oriented warnings.
CLANG_WARN_UNGUARDED_AVAILABILITY = YES_AGGRESSIVE
GCC_TREAT_WARNINGS_AS_ERRORS = NO
