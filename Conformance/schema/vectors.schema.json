{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spatialbridge.local/conformance/vectors.schema.json",
  "title": "Spatial Bridge conformance vector file",
  "type": "object",
  "required": ["version", "kind", "cases"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "kind": {
      "enum": ["framing", "control-messages", "canonical-json", "pairing", "session-auth",
               "ed25519", "sanitizer", "uti-policy", "coordinate-mapper"]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
